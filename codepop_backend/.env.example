# ---------------------------------------------------------------
# Local dev: copy this file to .env and fill in values.
# GCP VMs: SSH in and set these directly in .env — never commit .env.
# ---------------------------------------------------------------

# Set to False on all GCP VMs
DEBUG=True

# Generate a strong unique key: python -c "import secrets; print(secrets.token_hex(50))"
SECRET_KEY=your-secret-key-here

DB_NAME=codepop
DB_USER=codepop_user
# Use a strong unique password on each VM
DB_PASSWORD=change-this-password
DB_HOST=db
DB_PORT=5432

REDIS_URL=redis://redis:6379/0

# --- Node identity (unique per VM) ---
STORE_ID=0
STORE_NAME=Logan Master Hub
REGION=logan
# This VM's own externally reachable address — used for peer discovery and auto-registration
API_ENDPOINT=http://<THIS_VM_IP>:8000
LATITUDE=41.73
LONGITUDE=-111.83
# For stores: set to your regional hub's address e.g. http://10.0.0.1:8000
# For regional hubs: set to the master hub's address
# For master hub: leave empty
HUB_URL=
IS_HUB=False
IS_MASTER=False

# Generate a strong unique secret per cluster: python -c "import secrets; print(secrets.token_hex(32))"
INTER_NODE_SECRET=change-this-secret-before-prod

# Set to False on all GCP VMs
CORS_ALLOW_ALL_ORIGINS=True

# Set to the VM's IP or hostname on GCP e.g. 10.0.0.3,store-102.example.com
ALLOWED_HOSTS=*

STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
